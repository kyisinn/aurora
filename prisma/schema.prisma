// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// User model linked to Clerk
model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique // Clerk's user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  tasks     Task[]
  profile   Profile?
  schedules Schedule[]
  plans     Plan[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  minutes   Int
  due       String?
  priority  String   @default("medium")
  notes     String?  @db.Text
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  // ✅ When you plan to DO it
  scheduledDate String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id            String @id @default(uuid())
  preferences   Json?
  tools         Json?
  scheduleDraft Json?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id         String   @id @default(uuid())
  blocks     Json
  userPrompt String?  @db.Text
  createdAt  DateTime @default(now())
  
  // ✅ FIXED: Added @default(now()) so existing rows can migrate
  updatedAt  DateTime @default(now()) @updatedAt

  // ✅ The specific date this plan is for
  // Note: If you have existing data, they will all default to this date.
  date String   @default("2026-02-16")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ PREVENT DUPLICATES: Only one schedule per user per day
  @@unique([userId, date])
}

model Plan {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}